rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo: el socio puede consultar SU documento por cédula, pero nadie puede listar la colección.
    match /members/{id} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }
    // El socio solo puede crear su registro (no editarlo ni borrarlo). Admin lee todo.
    match /attendance/{id} {
      allow create: if request.resource.data.keys().hasOnly(['cedula','name','ok','at'])
                    && request.resource.data.at == request.time;
      allow read, update, delete: if request.auth != null;
    }
  }
}
